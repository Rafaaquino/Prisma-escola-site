{
  "name": "prisma-escola-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "description": "Site institucional da Prisma Escola (React + pré-renderização estática, GitHub Pages)",
  "scripts": {
    "css": "node scripts/build-css.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "predev": "npm run css && node scripts/image-sizes.mjs",
    "dev": "react-router dev",
    "start": "npm run dev",
    "prebuild": "npm run css && node scripts/image-sizes.mjs",
    "build": "react-router build && node scripts/postbuild.mjs",
    "preview": "node scripts/serve.mjs",
    "serve": "npm run build && npm run preview",
    "check:urls": "node scripts/check-urls.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "verify": "npm run build && npm run check:urls && npm run check:seo",
    "typecheck": "react-router typegen && tsc",
    "deploy": "node scripts/deploy.mjs",
    "deploy:simular": "node scripts/deploy.mjs --simular",
    "deploy:producao": "node scripts/deploy.mjs --producao"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "isbot": "^5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "swiper": "^14.3.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.0",
    "@react-router/node": "^8.5.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lightningcss": "^1.33.0",
    "purgecss": "^8.0.0",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  }
}
